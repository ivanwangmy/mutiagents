APP_ENV=development
APP_NAME=AI 智播课堂
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 默认使用 Docker 中的 PostgreSQL 16；SQLite 仅供应急回退
DATABASE_URL=postgresql+psycopg://classroom:classroom_dev_password@127.0.0.1:5432/ai_classroom
CHECKPOINTER_BACKEND=postgres
LANGGRAPH_CHECKPOINT_DB=./data/langgraph_checkpoints.db
LANGGRAPH_STORE_DB=./data/langgraph_store.db

# SSE 多进程/多 worker 部署时启用 Redis Pub/Sub；留空则使用进程内广播（单进程）
# Redis 容器：docker compose up -d redis
REDIS_URL=
EVENT_CHANNEL_PREFIX=classroom:sse:

# 模型密钥只放后端，禁止写入前端或提交 Git
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING_ENABLED=false

MAX_OUTPUT_TOKENS=800
MAX_CONTEXT_TOKENS=3000
TASK_TOKEN_BUDGET=12000
TASK_MAX_MODEL_CALLS=8
TASK_MAX_MESSAGES=12
TASK_MAX_TURNS=10
TASK_MAX_SECONDS=120
MEMORY_RETRIEVAL_LIMIT=3
MEMORY_RETRIEVAL_MIN_SCORE=0.35
MEMORY_EXTRACTION_ENABLED=true
MEMORY_EXTRACTION_TRANSCRIPT_CHARS=600

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
